# =============================================================================
# duo-scrapbook environment variables
# Copy to .env (root) and src/functions/local.settings.json (Values block) for
# local development. NEVER commit secrets.
# =============================================================================

# ---- Functions runtime ---------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL (Essential) ---------------------------------------------
# Local: docker postgres or `azure-local-debug` provisions this.
DATABASE_URL=postgresql://localdev:localdevpassword@localhost:5432/scrapbook

# ---- Blob Storage (Essential) -------------------------------------------
# Local: Azurite emulator (UseDevelopmentStorage=true)
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
PHOTOS_CONTAINER_NAME=photos

# ---- Azure OpenAI (Enhancement) -----------------------------------------
# Optional locally — service falls back to a placeholder caption if unset.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ---- Auth ---------------------------------------------------------------
# Mock auth: bcrypt cost factor + session lifetime in seconds.
AUTH_BCRYPT_COST=10
AUTH_SESSION_TTL_SECONDS=2592000

# ---- App ---------------------------------------------------------------
PHOTO_MAX_BYTES=10485760
PHOTO_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif
